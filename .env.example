# 生产环境标记
NODE_ENV=production

# 真实语音识别 WebSocket 地址（可选）
ASR_WS_URL=wss://your-asr-provider.com/v1/asr
ASR_API_KEY=your-asr-api-key

# 大模型接口（OpenAI 兼容，可选）
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-3.5-turbo

# 演示模式默认转写文本
DEMO_TRANSCRIPT=患者 李四 床号 08 体温 37.5 脉搏 82 呼吸 20 血压 128/85 主诉 胸闷气短 查体 神志清楚 双肺呼吸音粗 处理意见 吸氧 心电监护